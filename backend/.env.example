# NexAgent — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env to git.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
# Replace <password> with your actual postgres password — never use 'nexagent_pass' in production
DATABASE_URL=postgresql://nexagent:<password>@localhost:5432/nexagent_db?schema=public

# ── Security ──────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX_STRING

# Password used when seeding the admin account
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ── CCEP ──────────────────────────────────────────────────────────────────────
CCEP_THRESHOLD=0.60

# ── LLM ──────────────────────────────────────────────────────────────────────
# Set MOCK_MODE=true to run without real API keys (uses fixture responses)
MOCK_MODE=true
GEMINI_API_KEY=
GROQ_API_KEY=

# ── Infrastructure ───────────────────────────────────────────────────────────
CHROMADB_URL=http://localhost:8000

# Comma-separated allowed origins for CORS (default: localhost:3000 only)
ALLOWED_ORIGIN=http://localhost:3000

# ── Observability (optional) ─────────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ── Real MCP HTTP integrations ───────────────────────────────────────────────
# Jira Cloud REST API
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=REPLACE_WITH_JIRA_API_TOKEN

# Slack Bot Token (from api.slack.com/apps → OAuth & Permissions)
SLACK_BOT_TOKEN=xoxb-REPLACE_WITH_SLACK_BOT_TOKEN

# GitHub Personal Access Token (repo + pull_requests scope)
GITHUB_TOKEN=ghp_REPLACE_WITH_GITHUB_TOKEN
GITHUB_REPO=owner/repo-name

# PagerDuty REST API (new integration)
PAGERDUTY_TOKEN=REPLACE_WITH_PAGERDUTY_API_TOKEN
PAGERDUTY_SERVICE_ID=REPLACE_WITH_SERVICE_ID

# MCP Servers (optional — leave blank to use HTTP connectors above)
MCP_JIRA_CMD=
MCP_SLACK_CMD=
MCP_GITHUB_CMD=
MCP_SENTRY_CMD=

# ── Internal ──────────────────────────────────────────────────────────────────
# Secret used by fit_weights.py to record fitted weights via API
FIT_WEIGHTS_SECRET=REPLACE_WITH_RANDOM_SECRET
